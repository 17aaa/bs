{
  "name": "creative-nft-market",
  "version": "1.0.0",
  "description": "学生创意成果 NFT 确权与交易市场 - 智能合约",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy:amoy": "npx hardhat run scripts/deploy.js --network amoy",
    "deploy:polygon": "npx hardhat run scripts/deploy.js --network polygon",
    "deploy:local": "npx hardhat run scripts/deploy.js --network hardhat",
    "verify:amoy": "npx hardhat verify --network amoy",
    "verify:polygon": "npx hardhat verify --network polygon"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^4.9.0",
    "ethers": "^6.9.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
