# ============================================
# CreativeNFT User Service 环境变量配置
# 警告: 不要将包含真实私钥的 .env 文件提交到版本控制！
# ============================================

# ============================================
# Polygon 区块链配置
# ============================================
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com/

# 部署者私钥（用于 Hardhat 部署合约）
# 获取测试网 MATIC: https://faucet.polygon.technology/
PRIVATE_KEY=your_private_key_here

# 平台钱包私钥（用于后端调用合约）
# 警告: 生产环境请使用安全的密钥管理服务
BLOCKCHAIN_PLATFORM_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Polygonscan API Key（用于合约验证）
# 获取 API Key: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ============================================
# 合约地址（部署后填写）
# ============================================
NFT_ASSET_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
MICRO_MARKET_CONTRACT_ADDRESS=
FAN_TOKEN_CONTRACT_ADDRESS=

# ============================================
# IPFS 配置
# ============================================
# IPFS 模式：pinata（Pinata 服务，推荐）、local（本地 IPFS 节点）、disabled（降级到 MinIO）
IPFS_MODE=pinata
# IPFS 节点 URL（仅 local 模式使用）
IPFS_API_URL=http://localhost:5001
# IPFS 网关 URL（用于访问文件）
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
# Pinata API URL（仅 pinata 模式使用）
PINATA_API_URL=https://api.pinata.cloud
# Pinata JWT Token（注册 https://pinata.cloud 获取）
PINATA_JWT=your_pinata_jwt_token_here

# ============================================
# 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=nftuser
MYSQL_PASSWORD=nftpass123

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRATION=86400000

# ============================================
# 应用配置
# ============================================
SERVER_PORT=8085
LOG_LEVEL=INFO